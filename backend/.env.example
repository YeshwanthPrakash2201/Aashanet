# Copy this file to `.env` (same folder) and fill in real values.
# Never commit the real `.env`.

# PostgreSQL connection
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/aashanet

# JWT login tokens. Use a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Gemini (key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional. Model tried first, then the comma-separated fallbacks if it
# is busy or times out. Change these instead of editing the code.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash
# Hard limit for one Gemini request, in seconds.
GEMINI_TIMEOUT_SECONDS=60
